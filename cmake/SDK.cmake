include_guard(GLOBAL)
if(NOT TARGET Metamod::SDK)
    message(FATAL_ERROR "Load Metamod cmake/SDK.cmake before the ASExt SDK.")
endif()
if(NOT TARGET AngelScript::Headers)
    include("${CMAKE_CURRENT_LIST_DIR}/Revisions.cmake")
    mmfg_source(angelscript ANGELSCRIPT_SOURCE_PATH https://github.com/metamod-svencoop/angelscript-sdk.git
        "${MMFG_ANGELSCRIPT_REVISION}" "angelscript/include/angelscript.h" _asext_angelscript_source)
    add_library(mmfg_angelscript_headers INTERFACE)
    add_library(AngelScript::Headers ALIAS mmfg_angelscript_headers)
    target_include_directories(mmfg_angelscript_headers INTERFACE "${_asext_angelscript_source}/angelscript/include")
endif()
if(NOT TARGET ASExt::SDK)
    get_filename_component(asext_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
    add_library(mmfg_asext_sdk INTERFACE)
    add_library(ASExt::SDK ALIAS mmfg_asext_sdk)
    target_include_directories(mmfg_asext_sdk INTERFACE "${asext_root}/include")
    target_link_libraries(mmfg_asext_sdk INTERFACE Metamod::SDK AngelScript::Headers)
endif()
